# Публичный ключ клиентского виджета Yandex SmartCaptcha (используется во время npm run build)
NEXT_PUBLIC_SMARTCAPTCHA_SITE_KEY=

# Секретный ключ. На Beget задайте его как переменную окружения PHP,
# либо замените чтение getenv в public/api/send.php на защищённую конфигурацию вне public_html.
YANDEX_SMARTCAPTCHA_SECRET=

# Номер счётчика Яндекс Метрики (добавляется во время npm run build)
NEXT_PUBLIC_YANDEX_METRIKA_ID=
